{
  "title": "AI-Lab",
  "host": "0.0.0.0",
  "port": 8090,
  "models_root": "/models",
  "engines": {
    "llamacpp": {
      "binary": "/opt/ai/llama.cpp-builds/current/bin/llama-server",
      "source": {
        "path": "/opt/ai/llama.cpp",
        "builds": "/opt/ai/llama.cpp-builds",
        "legacy_build": "/opt/ai/llama.cpp/build",
        "cmake_args": ["-DGGML_CUDA=ON", "-DCMAKE_CUDA_ARCHITECTURES=native"],
        "line": "stable",
        "releases": "ggml-org/llama.cpp"
      }
    },
    "vllm": {
      "binary": "/opt/ai/vllm/current/bin/vllm",
      "source": {
        "releases": "vllm-project/vllm",
        "package": "vllm",
        "root": "/opt/ai/vllm",
        "uv": "/usr/local/bin/uv"
      }
    },
    "nemo": {
      "binary": "/opt/ai/nemo/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "nemo_toolkit",
        "install": "nemo_toolkit[asr]",
        "modules": ["nemo.collections.asr"],
        "requires_cuda": true,
        "root": "/opt/ai/nemo",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "onnx": {
      "binary": "/opt/ai/silero/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "onnxruntime",
        "modules": ["onnxruntime", "torch", "soundfile"],
        "requirements": ["torch", "soundfile"],
        "root": "/opt/ai/silero",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "pyannote": {
      "binary": "/opt/ai/pyannote/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "pyannote.audio",
        "modules": ["pyannote.audio"],
        "requires_cuda": true,
        "root": "/opt/ai/pyannote",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    }
  },
  "storage": {
    "reclaimable": [
      {
        "id": "package-cache",
        "name": "Package download cache",
        "path": "/var/lib/ai-lab/.cache/uv",
        "kind": "cache",
        "description": "Downloaded Python packages kept to make later updates faster."
      },
      {
        "id": "vllm-compile-cache",
        "name": "vLLM compile cache",
        "path": "/var/lib/ai-lab/.cache/vllm/torch_compile_cache",
        "kind": "cache",
        "description": "Generated kernels; the next matching load rebuilds them."
      },
      {
        "id": "flashinfer-cache",
        "name": "FlashInfer cache",
        "path": "/var/lib/ai-lab/.cache/flashinfer",
        "kind": "cache",
        "description": "Generated kernels; they are rebuilt when needed."
      }
    ]
  },
  "repositories": [
    {
      "id": "gguf",
      "name": "GGUF models",
      "format": "gguf"
    },
    {
      "id": "safetensors",
      "name": "Safetensors sources",
      "format": "safetensors"
    },
    {
      "id": "fp8",
      "name": "FP8",
      "format": "fp8"
    },
    {
      "id": "nvfp4",
      "name": "NVFP4",
      "format": "nvfp4"
    },
    {
      "id": "audio-nemo-diarization",
      "name": "NeMo speaker diarization",
      "format": "nemo",
      "task": "diarization",
      "subpath": "audio/diarization"
    },
    {
      "id": "audio-pyannote-diarization",
      "name": "Pyannote speaker diarization",
      "format": "pyannote",
      "task": "diarization",
      "subpath": "audio/diarization/pyannote"
    }
  ],
  "instances": [
    {
      "id": "qwen-coder",
      "engine": "llamacpp",
      "model_id": "gguf/qwen-coder/Qwen3.6-35B-A3B-UD-Q4_K_M",
      "port": 8080,
      "params": {
        "context_size": 32768,
        "parallel": 1,
        "cache_type_k": "q4_0",
        "cache_type_v": "q4_0",
        "flash_attention": true
      }
    },
    {
      "id": "gemma-general",
      "engine": "llamacpp",
      "model_id": "gguf/gemma-general/gemma-4-E4B-it-Q4_0",
      "port": 8081,
      "params": {
        "context_size": 32768,
        "parallel": 1,
        "cache_type_k": "q4_0",
        "cache_type_v": "q4_0",
        "flash_attention": true
      }
    }
  ]
}
