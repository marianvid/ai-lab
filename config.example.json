{
  "schema_version": 1,
  "title": "AI-Lab",
  "host": "0.0.0.0",
  "port": 8090,
  "model_roots": [
    {
      "id": "core",
      "name": "Core",
      "path": "/models",
      "enabled": true,
      "writable": true
    },
    {
      "id": "benchmark",
      "name": "Benchmark",
      "path": "/test_models",
      "enabled": true,
      "writable": true
    }
  ],
  "download_root": "benchmark",
  "models_root": "/models",
  "engines": {
    "llamacpp": {
      "binary": "/opt/ai/llama.cpp-builds/current/bin/llama-server",
      "source": {
        "path": "/opt/ai/llama.cpp",
        "builds": "/opt/ai/llama.cpp-builds",
        "legacy_build": "/opt/ai/llama.cpp/build",
        "cmake_args": [
          "-DGGML_CUDA=ON",
          "-DCMAKE_CUDA_ARCHITECTURES=native"
        ],
        "line": "stable",
        "releases": "ggml-org/llama.cpp"
      }
    },
    "vllm": {
      "binary": "/opt/ai/vllm/current/bin/vllm",
      "source": {
        "releases": "vllm-project/vllm",
        "package": "vllm",
        "root": "/opt/ai/vllm",
        "uv": "/usr/local/bin/uv"
      }
    },
    "nemo": {
      "binary": "/opt/ai/nemo/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "nemo_toolkit",
        "install": "nemo_toolkit[asr]",
        "modules": [
          "nemo.collections.asr"
        ],
        "requires_cuda": true,
        "root": "/opt/ai/nemo",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "onnx": {
      "binary": "/opt/ai/silero/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "onnxruntime",
        "modules": [
          "onnxruntime",
          "torch",
          "soundfile"
        ],
        "requirements": [
          "torch",
          "soundfile"
        ],
        "root": "/opt/ai/silero",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "pyannote": {
      "binary": "/opt/ai/pyannote/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/audio/server.py",
      "source": {
        "package": "pyannote.audio",
        "modules": [
          "pyannote.audio"
        ],
        "requires_cuda": true,
        "root": "/opt/ai/pyannote",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "paddleocr": {
      "binary": "/opt/ai/paddleocr/current/bin/python",
      "server": "/opt/ai-lab/ai_lab/images/server.py",
      "source": {
        "package": "paddleocr",
        "modules": [
          "paddleocr"
        ],
        "root": "/opt/ai/paddleocr",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv"
      }
    },
    "comfyui": {
      "binary": "/opt/ai/comfyui/current/.venv/bin/python",
      "server": "/opt/ai-lab/ai_lab/images/comfyui_server.py",
      "comfyui": "/opt/ai/comfyui/current/ComfyUI/main.py",
      "model_paths": [
        "/models",
        "/test_models"
      ],
      "source": {
        "kind": "git-app",
        "root": "/opt/ai/comfyui",
        "repository": "https://github.com/Comfy-Org/ComfyUI.git",
        "application": "ComfyUI",
        "python": "/opt/ai/python/cpython-3.12.14-linux-x86_64-gnu/bin/python3.12",
        "uv": "/usr/local/bin/uv",
        "requires_cuda": true,
        "verify_module": "server"
      }
    }
  },
  "media": {
    "result_ttl_s": 86400,
    "max_queue": 32,
    "max_input_bytes": 41943040,
    "max_result_bytes": 268435456
  },
  "images": {
    "workflow_root": "/etc/ai-lab/image-workflows",
    "state_dir": "/var/lib/ai-lab/image-jobs",
    "client_wait_s": 1800,
    "result_ttl_s": 86400,
    "profiles": {}
  },
  "gateway": {
    "max_upload_bytes": 26214400,
    "max_upload_pixels": 50000000,
    "max_upload_dimension": 8000,
    "task_timeouts": {
      "ocr": {
        "first_byte_s": 60,
        "between_bytes_s": 30
      }
    }
  },
  "storage": {
    "reclaimable": [
      {
        "id": "package-cache",
        "name": "Package download cache",
        "path": "/var/lib/ai-lab/.cache/uv",
        "kind": "cache",
        "description": "Downloaded Python packages kept to make later updates faster."
      },
      {
        "id": "vllm-compile-cache",
        "name": "vLLM compile cache",
        "path": "/var/lib/ai-lab/.cache/vllm/torch_compile_cache",
        "kind": "cache",
        "description": "Generated kernels; the next matching load rebuilds them."
      },
      {
        "id": "flashinfer-cache",
        "name": "FlashInfer cache",
        "path": "/var/lib/ai-lab/.cache/flashinfer",
        "kind": "cache",
        "description": "Generated kernels; they are rebuilt when needed."
      }
    ]
  },
  "repositories": [
    {
      "id": "gguf",
      "name": "GGUF models",
      "format": "gguf"
    },
    {
      "id": "safetensors",
      "name": "Safetensors sources",
      "format": "safetensors"
    },
    {
      "id": "fp8",
      "name": "FP8",
      "format": "fp8"
    },
    {
      "id": "nvfp4",
      "name": "NVFP4",
      "format": "nvfp4"
    },
    {
      "id": "audio-nemo-diarization",
      "name": "NeMo speaker diarization",
      "format": "nemo",
      "task": "diarization",
      "subpath": "audio/diarization"
    },
    {
      "id": "audio-pyannote-diarization",
      "name": "Pyannote speaker diarization",
      "format": "pyannote",
      "task": "diarization",
      "subpath": "audio/diarization/pyannote"
    },
    {
      "id": "images-paddleocr",
      "name": "PaddleOCR",
      "format": "paddleocr",
      "task": "ocr",
      "subpath": "images/ocr"
    },
    {
      "id": "images-comfyui-generation",
      "name": "ComfyUI generation models",
      "format": "comfyui",
      "task": "image-generation",
      "subpath": "images/generation"
    },
    {
      "id": "images-comfyui-edit",
      "name": "ComfyUI editing models",
      "format": "comfyui",
      "task": "image-edit",
      "subpath": "images/edit"
    }
  ],
  "instances": [
    {
      "id": "qwen-coder",
      "engine": "llamacpp",
      "model_id": "gguf/qwen-coder/Qwen3.6-35B-A3B-UD-Q4_K_M",
      "port": 8080,
      "params": {
        "context_size": 32768,
        "parallel": 1,
        "cache_type_k": "q4_0",
        "cache_type_v": "q4_0",
        "flash_attention": true
      }
    },
    {
      "id": "gemma-general",
      "engine": "llamacpp",
      "model_id": "gguf/gemma-general/gemma-4-E4B-it-Q4_0",
      "port": 8081,
      "params": {
        "context_size": 32768,
        "parallel": 1,
        "cache_type_k": "q4_0",
        "cache_type_v": "q4_0",
        "flash_attention": true
      }
    },
    {
      "id": "ocr",
      "engine": "paddleocr",
      "model_id": "images-paddleocr/pp-ocrv5",
      "port": 8092,
      "params": {}
    },
    {
      "id": "image-comic",
      "engine": "comfyui",
      "model_id": "images-comfyui-generation/comic-model",
      "port": 8093,
      "params": {}
    }
  ],
  "model_notes": {
    "chatterbox-turbo": {
      "short": "Fast natural speech for drafts and previews",
      "detail": "Excels at low-latency English speech generation. Use it for script previews, timing checks and rapid radio prototyping."
    },
    "qwen3-tts-1.7b-voicedesign": {
      "short": "Highest-quality expressive voices and character direction",
      "detail": "Excels at natural English delivery, accents, emotion and described character voices. This is the quality TTS choice for finished programmes."
    },
    "qwen3-tts-1.7b-customvoice": {
      "short": "Repeatable presenter voices across episodes",
      "detail": "Excels when the same built-in voice identity must recur across separate programmes. Use it for stable hosts and recurring contributors."
    }
  },
  "downloads": {
    "bundles": [
      {
        "name": "qwen-image-2512-nvfp4",
        "repo": "Comfy-Org/Qwen-Image_ComfyUI",
        "format": "comfyui",
        "task": "image-generation",
        "components": [
          {
            "role": "diffusion_model",
            "path": "split_files/diffusion_models/qwen_image_nvfp4.safetensors"
          },
          {
            "role": "text_encoder",
            "path": "split_files/text_encoders/qwen_2.5_vl_7b_nvfp4.safetensors"
          },
          {
            "role": "vae",
            "path": "split_files/vae/qwen_image_vae.safetensors"
          }
        ]
      },
      {
        "name": "qwen-image-edit-2511-fp8mixed",
        "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
        "format": "comfyui",
        "task": "image-edit",
        "components": [
          {
            "role": "diffusion_model",
            "path": "split_files/diffusion_models/qwen_image_edit_2511_fp8mixed.safetensors"
          },
          {
            "role": "text_encoder",
            "repo": "Comfy-Org/Qwen-Image_ComfyUI",
            "path": "split_files/text_encoders/qwen_2.5_vl_7b_nvfp4.safetensors"
          },
          {
            "role": "vae",
            "repo": "Comfy-Org/Qwen-Image_ComfyUI",
            "path": "split_files/vae/qwen_image_vae.safetensors"
          }
        ]
      },
      {
        "name": "flux2-dev-fp8mixed",
        "repo": "Comfy-Org/flux2-dev",
        "format": "comfyui",
        "task": "image-generation",
        "components": [
          {
            "role": "diffusion_model",
            "path": "split_files/diffusion_models/flux2_dev_fp8mixed.safetensors"
          },
          {
            "role": "text_encoder",
            "path": "split_files/text_encoders/mistral_3_small_flux2_fp4_mixed.safetensors"
          },
          {
            "role": "vae",
            "path": "split_files/vae/flux2-vae.safetensors"
          }
        ]
      }
    ]
  }
}
