@@ -0,0 +1,264 @@
+"""Regenerate one window of a finished song, keeping the rest of it (AI-Lab patch).
+
+The recipe proven in radio-lab/music's lab on 2026-11-05 (`research/yue2-window/lab.py`,
+test `t5`, and `splice.py`), run on the resident model instead of a second copy:
+
+1. AR: from the source's prefix (with the new lyrics) and its semantic tokens before the
+   window, generate exactly the window's length in new tokens, with the candidate's seed.
+2. Splice the tokens: before + new + after.
+3. NAR on a clip (the window plus `context_s` each side) with RePaint: after every flow
+   step the state outside the window is put back on the original trajectory
+   t*noise + (1-t)*x0, softened over `edge_s` at both ends. The noise is the whole song's
+   noise from the SOURCE request's seed, so the part outside the window stays the original.
+4. Decode the clip and splice it into the original audio, inside the forced zone
+   (`swap_margin_s` outside the window), with a `crossfade_s` crossfade.
+
+Every number comes in the command; nothing here has a default of its own.
+"""
+from __future__ import annotations
+
+import json
+import shutil
+import time
+from pathlib import Path
+
+import numpy as np
+
+# YuE2's semantic tokens per second, its audio sample rate and its flow steps (the model's own).
+FPS = 25
+SAMPLE_RATE = 48000
+NAR_STEPS = 32
+SOURCE_FILES = ("result.json", "request.json", "semantic.npy", "latent.npy",
+                "abc_tokens.npy", "audio.flac")
+SAMPLING_KEYS = ("temperature", "top_p", "top_k", "repetition_penalty", "penalty_window")
+
+
+def window_frames(start_s: float, end_s: float, frames: int) -> tuple[int, int]:
+    """The window [p1, p2) in frames, refused when it is empty or outside the song."""
+    p1, p2 = int(round(start_s * FPS)), int(round(end_s * FPS))
+    if not 0 <= p1 < p2 <= frames:
+        raise ValueError(f"window {start_s}-{end_s} s is outside the song (0-{frames / FPS:.2f} s)")
+    return p1, p2
+
+
+def clip_frames(p1: int, p2: int, frames: int, context_s: float) -> tuple[int, int]:
+    """The clip [c0, c1): the window plus `context_s` each side, inside the song."""
+    margin = int(round(context_s * FPS))
+    return max(0, p1 - margin), min(frames, p2 + margin)
+
+
+def keep_mask(length: int, w0: int, w1: int, edge_frames: int) -> np.ndarray:
+    """1 where the clip keeps the original, 0 inside the window, a ramp of `edge_frames` at its ends."""
+    keep = np.ones(length, np.float32)
+    keep[w0:w1] = 0
+    for i in range(edge_frames):
+        fraction = 1 - (i + 1) / (edge_frames + 1)
+        if w0 + i < w1:
+            keep[w0 + i] = max(keep[w0 + i], fraction)
+        if w1 - 1 - i >= w0:
+            keep[w1 - 1 - i] = max(keep[w1 - 1 - i], fraction)
+    return keep
+
+
+def channels_last(audio) -> np.ndarray:
+    """Audio as [samples, channels] float32."""
+    audio = np.asarray(audio, np.float32)
+    if audio.ndim == 1:
+        return audio[:, None]
+    if audio.shape[0] <= 2 < audio.shape[1]:
+        return audio.T.copy()
+    return audio
+
+
+def splice_audio(original: np.ndarray, clip: np.ndarray, clip_s: tuple[float, float],
+                 window_s: tuple[float, float], swap_margin_s: float, crossfade_s: float,
+                 rate: int = SAMPLE_RATE) -> np.ndarray:
+    """The original with the clip swapped in over the window plus `swap_margin_s`, crossfaded."""
+    original, clip = channels_last(original), channels_last(clip)
+    if clip.shape[1] != original.shape[1]:
+        clip = np.repeat(clip[:, :1], original.shape[1], axis=1)
+    c0, c1 = clip_s
+    w0, w1 = window_s
+    s0 = int(max(c0, w0 - swap_margin_s) * rate)
+    s1 = int(min(c1, w1 + swap_margin_s) * rate)
+    offset = int(c0 * rate)
+    segment = clip[s0 - offset:s1 - offset]
+    count = min(len(segment), s1 - s0, len(original) - s0)
+    out = original.copy()
+    if count <= 0:
+        return out
+    fade = min(int(crossfade_s * rate), count // 2)
+    new = segment[:count].copy()
+    if fade > 0:
+        ramp = np.linspace(0, 1, fade, dtype=np.float32)[:, None]
+        new[:fade] = out[s0:s0 + fade] * (1 - ramp) + segment[:fade] * ramp
+        new[count - fade:count] = (segment[count - fade:count] * (1 - ramp)
+                                   + out[s0 + count - fade:s0 + count] * ramp)
+    out[s0:s0 + count] = new
+    return out
+
+
+def changed_percent(new: list[int], old: list[int]) -> float:
+    """How many of the window's tokens differ from the original's, in percent."""
+    if not old:
+        return 0.0
+    return round(100 * float(np.mean(np.asarray(new) != np.asarray(old))), 1)
+
+
+def _read_json(path: Path) -> dict:
+    return json.loads(path.read_bytes().decode("utf-8"))
+
+
+def _write_json(path: Path, value: dict) -> None:
+    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+
+def load_source(source_dir: Path, weights: dict | None) -> dict:
+    """The source song's saved files, refused when one is missing or the model differs."""
+    for name in SOURCE_FILES:
+        if not (source_dir / name).is_file():
+            raise ValueError(f"Source song is missing {name}: {source_dir.name}")
+    result = _read_json(source_dir / "result.json")
+    if result.get("status") != "complete":
+        raise ValueError("Source song did not complete")
+    source_mot = (result.get("weights") or {}).get("mot")
+    if source_mot is not None and weights is not None and source_mot != weights.get("mot"):
+        raise ValueError("Source song was generated by a different YuE2 model; "
+                         "semantic tokens are model-specific")
+    score = source_dir / "score.abc"
+    return {"result": result,
+            "request": _read_json(source_dir / "request.json"),
+            "semantic": np.load(source_dir / "semantic.npy", allow_pickle=False).astype(np.int64).tolist(),
+            "latent": np.load(source_dir / "latent.npy", allow_pickle=False).astype(np.float32),
+            "abc_ids": np.load(source_dir / "abc_tokens.npy", allow_pickle=False).astype(np.int64).tolist(),
+            "score": score.read_text(encoding="utf-8") if score.is_file() else None}
+
+
+def full_noise(frames: int, seed: int):
+    """The whole song's NAR noise, drawn exactly as `yue2.nar` draws it for a song."""
+    import torch
+    generator = torch.Generator(device="cpu").manual_seed(int(seed))
+    return torch.randn((frames, 64), dtype=torch.float32, device="cpu", generator=generator)
+
+
+def repaint(model, prefix, tokens, noise, x0, keep, cancelled):
+    """Flow matching on one clip; where keep==1 the state is put back on the original trajectory."""
+    import torch
+    from yue2.nar import CachedNAR, Chunk
+    from yue2.protocol import CODEC_OFFSET, MUSIC_END
+    chunk = Chunk(list(prefix) + [t + CODEC_OFFSET for t in tokens] + [MUSIC_END], noise)
+    engine = CachedNAR(model, chunk)
+    try:
+        device, dtype = engine.device, engine.dtype
+        state = noise.to(device=device, dtype=dtype)
+        original = torch.as_tensor(x0, device=device, dtype=dtype)
+        start = noise.to(device=device, dtype=dtype)
+        kept = torch.as_tensor(keep, device=device, dtype=dtype)[:, None]
+        dt = 1.0 / NAR_STEPS
+        with torch.inference_mode():
+            for step in range(NAR_STEPS):
+                if cancelled():
+                    raise InterruptedError("Cancelled during the window's NAR")
+                t = 1.0 - step * dt
+                raw = torch.logit(torch.tensor(t, dtype=torch.float64)).clamp(-20, 20).item()
+                first = engine.velocity(state, raw)
+                middle = state - first * (dt / 2)
+                raw_mid = torch.logit(torch.tensor(t - dt / 2, dtype=torch.float64)).clamp(-20, 20).item()
+                state = state - engine.velocity(middle, raw_mid) * dt
+                after = t - dt
+                target = after * start + (1 - after) * original
+                state = kept * target + (1 - kept) * state
+        return state.float().cpu().numpy()
+    finally:
+        engine.close()
+
+
+def run_window(pipe, command: dict, events, cancelled) -> dict:
+    """One candidate: the source song with one window regenerated, saved as a song of its own."""
+    import soundfile as sf
+    from yue2 import SymbolicPlan
+    from yue2.protocol import CODEC_OFFSET, Sampling, SongRequest, token_prefixes
+    from yue2.sampling import generate_tokens
+
+    started = time.monotonic()
+    job_id = command["job_id"]
+    source_dir, out = Path(command["source_dir"]), Path(command["output_dir"])
+    source = load_source(source_dir, getattr(pipe, "weights", None))
+    semantic = source["semantic"]
+    frames = len(semantic)
+    p1, p2 = window_frames(float(command["start_s"]), float(command["end_s"]), frames)
+    length = p2 - p1
+    c0, c1 = clip_frames(p1, p2, frames, float(command["context_s"]))
+    request = SongRequest(**{**source["request"], "lyrics": command["lyrics"]})
+    prefix = token_prefixes(request, pipe.tokenizer, source["abc_ids"])
+
+    sampling = command["sampling"]
+    settings = Sampling(float(sampling["temperature"]), float(sampling["top_p"]),
+                        int(sampling["top_k"]), float(sampling["repetition_penalty"]),
+                        int(sampling["penalty_window"]), length, length)
+    counter = [0]
+
+    def on_token(phase, token):
+        counter[0] += 1
+        if counter[0] % 25 == 0:
+            events.progress(job_id, stage="window-ar", tokens=counter[0], of=length)
+
+    ar_in = prefix + [t + CODEC_OFFSET for t in semantic[:p1]]
+    ids, _timing, _truncated = generate_tokens(pipe._load_model(), ar_in, settings, int(command["seed"]),
+                                               "semantic", cancelled=cancelled, on_token=on_token,
+                                               use_cuda_graph=False)
+    new = [int(x) - CODEC_OFFSET for x in ids if int(x) >= CODEC_OFFSET][:length]
+    short = len(new) < length
+    if short:
+        new = new + semantic[p1 + len(new):p2]
+    tokens = semantic[:p1] + new + semantic[p2:]
+    ar_s = time.monotonic() - started
+
+    events.progress(job_id, stage="window-nar")
+    noise = full_noise(frames, request.seed)
+    keep = keep_mask(c1 - c0, p1 - c0, p2 - c0, int(round(float(command["edge_s"]) * FPS)))
+    nar_started = time.monotonic()
+    latent_clip = repaint(pipe._load_model(for_nar=True), prefix, tokens[c0:c1], noise[c0:c1],
+                          source["latent"][c0:c1], keep, cancelled)
+    nar_s = time.monotonic() - nar_started
+
+    events.progress(job_id, stage="window-decode")
+    decode_started = time.monotonic()
+    clip_audio = channels_last(pipe.decode(latent_clip))
+    original, rate = sf.read(source_dir / "audio.flac", dtype="float32", always_2d=True)
+    window_s, clip_s = (p1 / FPS, p2 / FPS), (c0 / FPS, c1 / FPS)
+    song = splice_audio(original, clip_audio, clip_s, window_s, float(command["swap_margin_s"]),
+                        float(command["crossfade_s"]), rate)
+    decode_s = time.monotonic() - decode_started
+
+    latent = source["latent"].copy()
+    latent[c0:c1] = latent_clip
+    out.mkdir(parents=True, exist_ok=True)
+    SymbolicPlan(request, source["score"], source["abc_ids"], prefix).save(out)
+    np.save(out / "semantic.npy", np.asarray(tokens, np.int32))
+    np.save(out / "latent.npy", latent.astype(np.float32))
+    sf.write(out / "audio.flac", song, rate, subtype="PCM_24")
+    sf.write(out / "window.wav", clip_audio, SAMPLE_RATE, subtype="PCM_24")
+    _write_json(out / "request.json", request.to_dict())
+    if (source_dir / "config.json").is_file():
+        shutil.copyfile(source_dir / "config.json", out / "config.json")
+    timings = {"ar_s": round(ar_s, 1), "nar_s": round(nar_s, 1), "decode_s": round(decode_s, 1),
+               "total_s": round(time.monotonic() - started, 1)}
+    window = {"source": source_dir.name, "window_s": [round(window_s[0], 2), round(window_s[1], 2)],
+              "clip_s": [round(clip_s[0], 2), round(clip_s[1], 2)], "frames": [p1, p2],
+              "clip_frames": [c0, c1], "seed": int(command["seed"]), "noise_seed": request.seed,
+              "context_s": command["context_s"], "edge_s": command["edge_s"],
+              "crossfade_s": command["crossfade_s"], "swap_margin_s": command["swap_margin_s"],
+              "sampling": {key: sampling[key] for key in SAMPLING_KEYS},
+              "tokens_changed_pct": changed_percent(new, semantic[p1:p2]),
+              "short_window": short, "timings": timings}
+    _write_json(out / "window.json", window)
+    audio_seconds = len(song) / rate
+    _write_json(out / "result.json", {
+        "status": "complete", "sample_rate": rate, "audio_seconds": audio_seconds,
+        "truncated": {"abc": False, "semantic": False},
+        "weights": source["result"].get("weights"),
+        "sources": {"song": source_dir.name, "result_json": "a window regenerated from this song"},
+        "window": window})
+    return {"status": "complete", "output": str(out), "audio_seconds": audio_seconds,
+            "truncated": False, "seconds": timings["total_s"], "window": window}
