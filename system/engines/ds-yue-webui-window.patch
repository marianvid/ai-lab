+"""The window job (AI-Lab patch): validation, the route, the job command and the pure helpers."""
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "worker"))
+import yue2_window  # noqa: E402
+
+from server.validation import ValidationError, section_tags, validate_window  # noqa: E402
+
+SAMPLING = {"temperature": 1.0, "top_p": 0.95, "top_k": 100, "repetition_penalty": 1.2,
+            "penalty_window": 50}
+LYRICS = "[Verse]\nLa la\n[Chorus]\nminute"
+
+
+def _params(**changes):
+    params = {"source": "song-a", "start_s": 2.0, "end_s": 4.0, "lyrics": LYRICS, "seed": 101,
+              "context_s": 5.0, "edge_s": 0.4, "crossfade_s": 0.3, "swap_margin_s": 2.5,
+              "sampling": dict(SAMPLING)}
+    params.update(changes)
+    return params
+
+
+def _source(settings, name="song-a", seconds=10.0, skip=()):
+    directory = settings.outputs_dir / name
+    directory.mkdir(parents=True, exist_ok=True)
+    files = {"result.json": json.dumps({"status": "complete", "audio_seconds": seconds}),
+             "request.json": json.dumps({"style": "rap", "lyrics": LYRICS, "seed": 9202}),
+             "semantic.npy": "", "latent.npy": "", "abc_tokens.npy": "", "audio.flac": ""}
+    for file, text in files.items():
+        if file not in skip:
+            (directory / file).write_text(text, encoding="utf-8")
+    return directory
+
+
+# -- validation -------------------------------------------------------------
+
+def test_validate_window_accepts_a_full_request():
+    cleaned, warnings = validate_window(_params())
+    assert cleaned["start_s"] == 2.0 and cleaned["seed"] == 101 and warnings == []
+    assert cleaned["sampling"] == SAMPLING
+
+
+@pytest.mark.parametrize("changes, words", [
+    ({"end_s": 2.0}, "after start_s"),
+    ({"swap_margin_s": 6.0}, "forced zone"),
+    ({"seed": None}, "seed is required"),
+    ({"lyrics": " "}, "lyrics"),
+    ({"source": "../x"}, "library song"),
+    ({"context_s": -1}, "context_s"),
+    ({"sampling": {"temperature": 1.0}}, "sampling must give"),
+    ({"extra": 1}, "Unknown"),
+])
+def test_validate_window_refusals(changes, words):
+    with pytest.raises(ValidationError, match=words):
+        validate_window(_params(**changes))
+
+
+def test_validate_window_needs_every_number():
+    params = _params()
+    del params["edge_s"]
+    with pytest.raises(ValidationError, match="Missing window fields"):
+        validate_window(params)
+
+
+def test_section_tags_in_order():
+    assert section_tags("[Intro]\nx\n[Verse 1]\ny") == ["[Intro]", "[Verse 1]"]
+
+
+# -- the route and the job ----------------------------------------------------
+
+def _poll(client, job_id, timeout=30.0):
+    deadline = time.time() + timeout
+    while True:
+        job = client.get(f"/api/jobs/{job_id}").json()
+        if job["status"] in ("done", "failed", "cancelled"):
+            return job
+        assert time.time() < deadline
+        time.sleep(0.1)
+
+
+def test_window_job_flow(client, settings):
+    _source(settings)
+    response = client.post("/api/jobs", json={"kind": "window", "params": _params()})
+    assert response.status_code == 200, response.text
+    job = _poll(client, response.json()["job"]["id"])
+    assert job["status"] == "done", job
+    assert Path(job["output_dir"]).name.startswith("song-a-w101")
+    assert job["result"]["window"]["source"] == "song-a"
+
+
+@pytest.mark.parametrize("params, skip, words", [
+    (_params(lyrics="[Verse]\nLa\n[Bridge]\nx"), (), "section tags"),
+    (_params(end_s=12.0), (), "ends after the song"),
+    (_params(), ("latent.npy",), "files are gone"),
+    (_params(source="nobody"), (), "files are gone"),
+])
+def test_window_route_refusals(client, settings, params, skip, words):
+    _source(settings, skip=skip)
+    response = client.post("/api/jobs", json={"kind": "window", "params": params})
+    assert response.status_code == 400
+    assert words in response.json()["detail"]
+
+
+def test_window_command_carries_every_field(queue, settings):
+    source = _source(settings)
+    params = {**validate_window(_params())[0], "output_dir": str(settings.outputs_dir / "out")}
+    _spec, command = queue._build("window", params)
+    assert command["action"] == "window" and command["source_dir"] == str(source)
+    for key in ("start_s", "end_s", "lyrics", "seed", "context_s", "edge_s", "crossfade_s",
+                "swap_margin_s", "sampling"):
+        assert command[key] == params[key]
+
+
+# -- the pure helpers of the recipe -------------------------------------------
+
+def test_window_and_clip_frames():
+    assert yue2_window.window_frames(2.0, 4.0, 250) == (50, 100)
+    assert yue2_window.clip_frames(50, 100, 250, 5.0) == (0, 225)
+    with pytest.raises(ValueError, match="outside the song"):
+        yue2_window.window_frames(9.0, 11.0, 250)
+
+
+def test_keep_mask_ramps_into_the_window():
+    keep = yue2_window.keep_mask(20, 5, 15, 2)
+    assert keep[:5].tolist() == [1.0] * 5 and keep[15:].tolist() == [1.0] * 5
+    assert keep[5] == pytest.approx(2 / 3) and keep[6] == pytest.approx(1 / 3)
+    assert keep[14] == pytest.approx(2 / 3) and keep[10] == 0.0
+
+
+def test_splice_keeps_the_outside_and_fades():
+    rate = 100
+    original = np.zeros((1000, 2), np.float32)
+    clip = np.ones((600, 2), np.float32)             # the clip covers 2.0-8.0 s
+    out = yue2_window.splice_audio(original, clip, (2.0, 8.0), (4.0, 6.0), 1.0, 0.1, rate)
+    assert out[:300].max() == 0.0 and out[700:].max() == 0.0     # outside the swap zone
+    assert out[350:650].min() == 1.0                             # inside it
+    assert 0.0 < out[302, 0] < 1.0                               # the crossfade
+
+
+def test_splice_takes_mono_and_channels_first():
+    original = np.zeros((1000, 2), np.float32)
+    clip = np.ones((2, 600), np.float32)
+    out = yue2_window.splice_audio(original, clip, (2.0, 8.0), (4.0, 6.0), 1.0, 0.0, 100)
+    assert out[400].tolist() == [1.0, 1.0]
+    mono = yue2_window.splice_audio(original, np.ones(600, np.float32), (2.0, 8.0), (4.0, 6.0), 1.0, 0.0, 100)
+    assert mono[400].tolist() == [1.0, 1.0]
+
+
+def test_changed_percent():
+    assert yue2_window.changed_percent([1, 2, 3, 4], [1, 0, 3, 0]) == 50.0
+    assert yue2_window.changed_percent([], []) == 0.0
+
+
+def test_load_source_refuses_missing_files_and_other_models(tmp_path):
+    with pytest.raises(ValueError, match="missing result.json"):
+        yue2_window.load_source(tmp_path, None)
+    for name in yue2_window.SOURCE_FILES:
+        (tmp_path / name).write_text("{}")
+    (tmp_path / "result.json").write_text(json.dumps({"status": "complete", "weights": {"mot": "a"}}))
+    with pytest.raises(ValueError, match="different YuE2 model"):
+        yue2_window.load_source(tmp_path, {"mot": "b"})
+
+
+# -- run_window end to end, with the model's stages replaced -------------------
+
+class _FakePipe:
+    """The parts of YuE2Pipeline run_window uses; decode gives one 48 kHz sample per latent slot."""
+
+    weights = {"mot": "same"}
+    tokenizer = None
+
+    def _load_model(self, for_nar=False):
+        return None
+
+    def decode(self, latents):
+        frames = len(latents)
+        return np.full((frames * 48000 // 25, 2), 0.5, np.float32)
+
+
+class _Events:
+    def __init__(self):
+        self.seen = []
+
+    def progress(self, job_id, **fields):
+        self.seen.append(fields)
+
+
+def test_run_window_writes_a_whole_song(tmp_path, monkeypatch):
+    pytest.importorskip("yue2")
+    import soundfile as sf
+    import yue2.protocol
+    import yue2.sampling
+
+    frames, seconds = 250, 10.0
+    source = tmp_path / "song-a"
+    source.mkdir()
+    (source / "result.json").write_text(json.dumps({"status": "complete", "weights": {"mot": "same"}}))
+    (source / "request.json").write_text(json.dumps(
+        {"style": "rap", "lyrics": LYRICS, "cot": "full", "seed": 9202, "abc": None,
+         "cfg_scale": None, "id": "song"}))
+    np.save(source / "semantic.npy", np.arange(frames, dtype=np.int32) % 7)
+    np.save(source / "latent.npy", np.zeros((frames, 64), np.float32))
+    np.save(source / "abc_tokens.npy", np.asarray([1, 2, 3], np.int32))
+    (source / "score.abc").write_text("X:1\n")
+    sf.write(source / "audio.flac", np.zeros((int(seconds * 48000), 2), np.float32), 48000)
+
+    monkeypatch.setattr(yue2.protocol, "token_prefixes", lambda request, tokenizer, ids: [5, 6])
+    offset = yue2.protocol.CODEC_OFFSET
+    monkeypatch.setattr(yue2.sampling, "generate_tokens",
+                        lambda model, prefix, sampling, seed, phase, **_: (
+                            [offset + 9] * (sampling.max_tokens - 5), {}, False))
+    monkeypatch.setattr(yue2_window, "repaint",
+                        lambda model, prefix, tokens, noise, x0, keep, cancelled:
+                        np.ones((len(tokens), 64), np.float32))
+    out = tmp_path / "out"
+    command = {"job_id": 1, "source_dir": str(source), "output_dir": str(out), **_params(),
+               "lyrics": LYRICS.replace("minute", "minut")}
+    result = yue2_window.run_window(_FakePipe(), command, _Events(), lambda: False)
+
+    window = json.loads((out / "window.json").read_text())
+    assert result["status"] == "complete" and window["short_window"] is True
+    assert window["frames"] == [50, 100] and window["noise_seed"] == 9202 and window["seed"] == 101
+    semantic = np.load(out / "semantic.npy")
+    assert semantic[:50].tolist() == (np.arange(50) % 7).tolist()        # before: the original
+    assert semantic[50:95].tolist() == [9] * 45                          # the new tokens
+    assert semantic[95:100].tolist() == (np.arange(95, 100) % 7).tolist()  # padded from the original
+    latent = np.load(out / "latent.npy")
+    assert latent[:, 0].sum() == 225                                     # the clip 0-9 s replaced
+    song, rate = sf.read(out / "audio.flac", always_2d=True)
+    assert song[int(8 * rate)].tolist() == [0.0, 0.0]                    # after the swap zone (6.5 s)
+    assert abs(song[int(3 * rate), 0] - 0.5) < 1e-3                       # inside it
+    request = json.loads((out / "request.json").read_text())
+    assert "minut" in request["lyrics"] and request["seed"] == 9202
+    for name in ("plan.json", "prefix.npy", "abc_tokens.npy", "score.abc", "window.wav", "result.json"):
+        assert (out / name).is_file(), name
