# One unit for every engine instance. %i is the instance id.
#
# Instances are created from the interface at runtime, so the command line
# cannot live in this file. The manager writes it to
# /var/lib/ai-lab/launch/%i.json and ai-lab-run reads it and execs.
#
# This runs as ai-lab-manager, the same user as the manager itself, so a
# manager-written command line grants no privilege the manager did not already
# have. llama-server needs no root: only /dev/nvidia* and the model files.

[Unit]
Description=AI-Lab inference instance %i
After=network-online.target
Wants=network-online.target
StopWhenUnneeded=no

[Service]
Type=simple
User=ai-lab-manager
Group=ai-lab-manager
# Say where the home directory is, instead of trusting the account's entry in
# /etc/passwd. vLLM needs one: FlashInfer creates a working directory under
# $HOME before it will start, and llama.cpp never noticed because it writes
# nothing there. Stating it here means a rebuilt container works straight away,
# with no hand-edited passwd entry to remember.
Environment=HOME=/var/lib/ai-lab
ExecStart=/opt/ai-lab/.venv/bin/ai-lab-run %i
Restart=no
# SIGTERM first, then systemd insists. An engine has nothing to save: the
# weights are on disk and the driver reclaims the card either way, so a long
# wait buys nothing and makes an unload feel broken. Measured on this machine:
# llama.cpp exits in about half a second; vLLM in the middle of generating did
# not answer SIGTERM within a minute and had to be killed. So the limit is set
# by how long somebody should wait for a stop, not by hope of a clean exit.
#
# ai_lab/hosts/linux.py waits longer than this on purpose, and a test asserts
# it: a caller whose patience equals systemd's times out on its own success.
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
